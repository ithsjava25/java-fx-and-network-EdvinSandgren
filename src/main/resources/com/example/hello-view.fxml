<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HelloController">
    <HBox alignment="CENTER" prefHeight="40.0" prefWidth="542.0">
        <Label alignment="CENTER" text="Topic:">
         <padding>
            <Insets right="5.0" />
         </padding></Label>
        <TextField fx:id="topicLabel" alignment="CENTER" text="mytopic">
         <HBox.margin>
            <Insets right="5.0" />
         </HBox.margin></TextField>
      <Button onAction="#setTopic" mnemonicParsing="false" text="Set" />
    </HBox>
    <ListView fx:id="messageView" />

    <HBox alignment="BOTTOM_CENTER" prefHeight="62.0">
        <TextArea fx:id="messageField" prefHeight="55.0">
            <HBox.margin>
                <Insets bottom="4.0" left="4.0" top="3.0" />
            </HBox.margin>
        </TextArea>
        <VBox alignment="CENTER_RIGHT" prefHeight="60.0" prefWidth="60.0">
            <Button prefHeight="20.0" prefWidth="50.0" text="Attach">
                <VBox.margin>
                    <Insets bottom="2.0" right="5.0" />
                </VBox.margin>
            </Button>
            <Button onAction="#sendMessage" prefHeight="20.0" prefWidth="50.0" text="Send">
                <VBox.margin>
                    <Insets right="5.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </HBox>

</VBox>
